{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "python3 bot.py",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "RAILWAY_MODE": "true",
    "VIDEO_COMPRESSION_TARGET_MB": "20",
    "MAX_VIDEO_DURATION_SEC": "300",
    "MAX_STORAGE_MB": "400"
  }
}
